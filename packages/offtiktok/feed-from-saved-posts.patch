+export async function fetchNextSavedPost(excludeTiktokIds: string[]) {
+  const next = await prisma.post.findFirst({
+    orderBy: {
+      createdAt: 'desc',
+    },
+    select: {
+      id: true,
+    },
+    where: {
+      deleted: {
+        equals: false,
+      },
+      tiktokId: {
+        notIn: excludeTiktokIds,
+      },
+    },
+  });
+  return next ? await fetchPostById(next.id) : null;
+}

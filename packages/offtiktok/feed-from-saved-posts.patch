+export async function fetchNextOlderSavedPost(currentTiktokId: string) {
+  const findNewestSaved = (olderThan?: string) =>
+    prisma.post.findFirst({
+      orderBy: {
+        tiktokId: 'desc',
+      },
+      select: {
+        id: true,
+      },
+      where: {
+        deleted: {
+          equals: false,
+        },
+        tiktokId: olderThan ? { lt: olderThan } : { not: currentTiktokId },
+      },
+    });
+  const next =
+    (await findNewestSaved(currentTiktokId)) ?? (await findNewestSaved());
+  return next ? await fetchPostById(next.id) : null;
+}
